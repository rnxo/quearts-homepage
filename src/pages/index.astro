---
import BaseLayout from "#/layouts/BaseLayout.astro";
import Reveal from "#/components/Reveal";
import SectionHeading from "#/components/SectionHeading";
import SongCard from "#/components/SongCard";
import { songs } from "#/models/songs";
import { sortedNews } from "#/models/news";
---

<BaseLayout>
  {/* バナー。下端を背景色に溶かし、アイコンを重ねる */}
  <div class="relative h-32 sm:h-52">
    <img
      src="/assets/homepage-banner.png"
      alt="quearts-backimage"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-linear-to-b from-transparent from-40% to-(--paper)"></div>
  </div>

  <main class="page-wrap px-4 pb-24 sm:px-6">
    {/* 自己紹介 */}
    <section class="relative -mt-16 sm:-mt-24 border-b border-(--rule)">
      <div class="grid grid-cols-3 gap-5 mb-16">
        <div class="flex justify-center items-center">
          <img
            src="/assets/quearts-icon.png"
            alt="quearts-icon"
            width={220}
            height={220}
            class="aspect-square w-32 rounded-full border-4 border-(--paper) object-cover md:w-55"
          />
        </div>
        <div class="flex flex-col justify-center items-start">
          <p class="kicker m-0">VOCALOID PRODUCER</p>
          <h1 class="display text-[clamp(2.6rem,7vw,4.4rem)]">Quearts</h1>
        </div>
        <!-- <div class="border w-px h-[80%]"></div> -->
        <div class="flex justify-start items-center">
          <p class="mt-6 max-w-[36em] text-sm leading-[2.1] text-(--ink-soft)">
            活動内容をこちらに記載する（もしくはこの欄ごとなしにする）
          </p>
        </div>
      </div>

    </section>
    {/* ニュースリスト */}
    <div class="my-20">
      <Reveal client:visible>
        <SectionHeading kicker="News" title="Recent Updates">
          <a slot="action" href="/news" class="nav-link text-sm">
            一覧を見る →
          </a>
        </SectionHeading>
      </Reveal>
      <Reveal client:visible>
        <ul class="m-0 list-none p-0">
          {sortedNews.map((newsItem) => (
            <li class="flex flex-col gap-1 border-b border-[var(--rule)] py-5 sm:flex-row sm:items-baseline sm:gap-6">
              <span class="kicker shrink-0">{newsItem.releasedAt}</span>
              <span class="text-sm">{newsItem.title}</span>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
    <Reveal client:visible>
      <SectionHeading kicker="Discography" title="Latest Releases">
        <a slot="action" href="/discography" class="nav-link text-sm">
          一覧を見る →
        </a>
      </SectionHeading>
    </Reveal>
    <Reveal client:visible>
      {/* ソングカード */}
      <div class="mt-8 flex flex-col gap-8">
        {songs.map((song) => (
          <SongCard song={song} />
        ))}
      </div>
    </Reveal>
  </main>
</BaseLayout>
