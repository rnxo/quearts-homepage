---
import BaseLayout from '#/layouts/BaseLayout.astro'
import Reveal from '#/components/Reveal'
import { DiscoSongs } from '#/models/songs'
//import SquareSongCard from '#/components/discography/SquareSongCard'
import VerticalSongCard from '#/components/discography/VerticalSongCard'
import HorizontalScrollContainer from '#/components/discography/HorizontalScrollContainer'
---

<BaseLayout title="Discography — Quearts">
  <main class="page-wrap px-4 py-16 sm:px-6 sm:py-20">
    <Reveal client:visible>
      <h1 class="display text-center text-3xl sm:text-5xl">Releases</h1>
      <hr class="rule-line mt-8" />
    </Reveal>

    <Reveal client:visible className="mt-12">
      <HorizontalScrollContainer
        client:load
        label="Releases"
        className="-mx-4 sm:-mx-6"
      >
        {DiscoSongs.map((song) => (
          <VerticalSongCard song={song} className="hscroll-track-item" />
        ))}
      </HorizontalScrollContainer>
    </Reveal>
  </main>
</BaseLayout>
