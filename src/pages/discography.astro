---
import BaseLayout from '#/layouts/BaseLayout.astro'
import Reveal from '#/components/Reveal'
import { DiscoSongs } from '#/models/songs'
// import SquareSongCard from '#/components/discography/SquareSongCard'
import GridSongCard from '#/components/discography/GridSongCard'

// 案C — 主役をつくる非対称グリッド
// 先頭の曲を主役として大きく、次の2曲を右に縦積み、残りを下段に並べる
const [featured, ...rest] = DiscoSongs
const sideSongs = rest.slice(0, 2)
const bottomSongs = rest.slice(2)
---

<BaseLayout title="Discography — Quearts">
  <main class="page-wrap px-4 py-16 sm:px-6 sm:py-20">
    <Reveal client:visible>
      <h1 class="display text-center text-3xl sm:text-5xl underline decoration-2 decoration-green-400">
        Releases
      </h1>
      <hr class="rule-line mt-8" />
    </Reveal>
    <Reveal client:visible className="mt-12">
      <div class="flex flex-col gap-6">
        {/* 主役 + 右2枚 */}
        <div class="grid gap-6 md:grid-cols-5">
          {featured && (
            <GridSongCard
              song={featured}
              featured
              className="md:col-span-3 md:row-span-2"
            />
          )}
          {sideSongs.map((song) => (
            <GridSongCard song={song} className="md:col-span-2" />
          ))}
        </div>
        {/* 下段 */}
        {bottomSongs.length > 0 && (
          <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
            {bottomSongs.map((song) => (
              <GridSongCard song={song} />
            ))}
          </div>
        )}
      </div>
    </Reveal>

    {/* 旧: 2列の均等グリッド
      <div class="grid grid-cols-2 gap-7">
        { DiscoSongs.map((song) => (
          <SquareSongCard song={song} />
        ))}
      </div>
    */}
    <!-- <Reveal client:visible className="mt-12" /> -->
  </main>
</BaseLayout>

