---
import BaseLayout from "#/layouts/BaseLayout.astro";
import Reveal from "#/components/Reveal.astro";
import { DiscoSongs } from "#/models/songs";
import SquareSongCard from "#/components/discography/SquareSongCard.astro";
---

<BaseLayout title="Discography — Quearts">
  <main class="page-wrap px-4 py-16 sm:px-6 sm:py-20">
    <Reveal>
      <h1 class="display text-center text-3xl sm:text-5xl">Discography</h1>
      <hr class="rule-line mt-8" />
    </Reveal>
    <Reveal class="mt-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
        {DiscoSongs.map((song) => <SquareSongCard song={song} />)}
      </div>
    </Reveal>
  </main>
</BaseLayout>
