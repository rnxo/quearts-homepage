---
import BaseLayout from '#/layouts/BaseLayout.astro'
import Reveal from '#/components/Reveal'
import SongCard from '#/components/SongCard'
import { songs } from '#/models/songs'
---

<BaseLayout title="Discography — Quearts">
  <main class="page-wrap px-4 py-16 sm:px-6 sm:py-20">
    <Reveal client:visible>
      <p class="kicker mb-4">Discography</p>
      <h1 class="display text-3xl sm:text-5xl">Releases</h1>
      <hr class="rule-line mt-8" />
    </Reveal>

    <Reveal client:visible className="mt-12">
      <div class="flex flex-col gap-8">
        {songs.map((song) => (
          <SongCard song={song} />
        ))}
      </div>
    </Reveal>
  </main>
</BaseLayout>
