---
import type { Song } from "#/models/songs";
import SongLinks from "#/components/SongLinks.astro";
import { cn } from "#/lib/utils";

type Props = {
  song: Song;
  class?: string;
};

const { song, class: className } = Astro.props;
---

<div
  class={cn(
    "flex flex-col rounded-lg bg-(--paper-sub) shadow-[0_8px_24px_rgba(0,0,0,0.08)] ring-1 ring-(--rule)",
    className,
  )}
>
  <div class="px-4 pt-4">
    <img
      src={`/assets/songs/${song.slug}.png`}
      alt={song.title}
      class="aspect-video w-full rounded-md object-cover"
    />
  </div>
  <h2 class="display m-0 px-4 pt-4 text-2xl text-center sm:text-3xl">
    {song.title}
  </h2>
  <SongLinks
    class="mb-auto"
    youtube={song.links?.youtube}
    niconico={song.links?.niconico}
    piapro={song.links?.piapro}
  />
</div>
