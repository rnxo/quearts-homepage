---
import type { Song } from "#/models/songs";
import SongLinks from "./SongLinks.astro";

type Props = {
  song: Song;
};

const { song } = Astro.props;
---

<div
  class="flex flex-col gap-5 sm:flex-row rounded-lg bg-(--paper-sub) shadow-[0_8px_24px_rgba(0,0,0,0.08)] ring-1 ring-(--rule)"
>
  {/* 音楽画像 */}
  <img
    src={`/assets/songs/${song.slug}.png`}
    alt={song.slug}
    class="w-full sm:w-[55%] aspect-video object-cover p-5 pb-0 sm:pb-5 rounded-4xl"
  />
  {/* ソングカード右部分 */}
  <div class="flex min-w-0 flex-1 flex-col justify-center gap-5 p-6">
    <h2 class="display text-3xl text-center">{song.title}</h2>
    {/* 詳細カード */}
    <dl
      class="grid w-full grid-cols-[auto_1fr] gap-x-6 gap-y-3 rounded-md bg-(--paper) p-5 text-sm ring-1 ring-(--rule)"
    >
      <dt class="kicker self-center">Singer</dt>
      <dd class="m-0">{song.singer}</dd>
      <dt class="kicker self-center">Release</dt>
      <dd class="m-0">{song.releasedAt}</dd>
      <dt class="kicker self-center">Role</dt>
      <dd class="m-0">{song.role}</dd>
    </dl>
    {/* youtube, niconico, piapuroのリンク */}
    <SongLinks
      youtube={song.links?.youtube}
      niconico={song.links?.niconico}
      piapro={song.links?.piapro}
    />
  </div>
</div>
