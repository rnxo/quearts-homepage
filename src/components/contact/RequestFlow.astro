---
import { ArrowRight } from 'lucide-react'
import { getEntry, render } from 'astro:content'
import ExternalLink from './ExternalLink.astro'
import { RequestFlowStep } from './RequestFlowStep'

// contentId は src/content/flow-item-md/ のファイル名（拡張子なし）
const flowItemData = [
  {
    id: '1',
    name: 'ヒアリング',
    simpleText: 'メールにて連絡',
    contentId: '01_hearing',
  },
  {
    id: '2',
    name: 'お見積り',
    simpleText: 'メールの内容をお見積りを提案',
    contentId: '02_estimate',
  },
  {
    id: '3',
    name: 'ラフ制作',
    simpleText: 'ざっくりした１コーラス分を制作',
    contentId: '03_rough',
  },
  {
    id: '4',
    name: '本制作',
    simpleText: '諸々確定後、本制作に移る',
    contentId: '04_main_work',
  },
  {
    id: '5',
    name: 'お支払い',
    simpleText: 'PayPal・銀行振込',
    contentId: '05_paying',
  },
  {
    id: '6',
    name: '微調整・納品',
    simpleText: 'ギガファイル便にて音声データを納品',
    contentId: '06_delivery',
  },
]

// コレクションから MDX を取り出して、描画用の Content コンポーネントにする
const requestFlowItems = await Promise.all(
  flowItemData.map(async ({ contentId, ...flowItem }) => {
    const entry = await getEntry('flowItem', contentId)
    if (!entry) {
      throw new Error(`flow-item-md/${contentId}.mdx が見つかりません`)
    }
    const { Content } = await render(entry)
    return { ...flowItem, Content }
  }),
)
---

<ol class="m-0 flex list-none items-center gap-1 p-0 sm:gap-2">
  {requestFlowItems.map(({ Content, ...flowItem }, index) => (
    <>
      <li class="min-w-0 flex-1">
        {/* MDX はここで描画し、ダイアログの中身として island に渡す */}
        <RequestFlowStep client:visible flowItem={flowItem}>
          <Content components={{ a: ExternalLink }} />
        </RequestFlowStep>
      </li>
      {index < requestFlowItems.length - 1 && (
        <li aria-hidden="true" class="shrink-0 text-(--ink-soft)">
          <ArrowRight className="size-3 sm:size-4" />
        </li>
      )}
    </>
  ))}
</ol>
<div class="m-2 p-2 h-[20%] w-full flex justify-end">
  <p class="text-[0.8rem] font-bold text-(--ink-soft)">
    各カードをクリックすると詳細がでます
  </p>
</div>
