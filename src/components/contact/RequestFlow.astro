---
import { Minus, Plus } from "@lucide/astro";
import { getEntry, render } from "astro:content";
import ExternalLink from "./ExternalLink.astro";

// contentId は src/content/flow-item-md/ のファイル名（拡張子なし）
const flowItemData = [
  { id: "1", name: "ヒアリング", nameEn: "Hearing", contentId: "01_hearing" },
  { id: "2", name: "お見積り", nameEn: "Estimate", contentId: "02_estimate" },
  {
    id: "3",
    name: "ラフ制作",
    nameEn: "Rough Production",
    contentId: "03_rough",
  },
  {
    id: "4",
    name: "本制作",
    nameEn: "Production",
    contentId: "04_main_work",
  },
  { id: "5", name: "お支払い", nameEn: "Payment", contentId: "05_paying" },
  {
    id: "6",
    name: "微調整・納品",
    nameEn: "Delivery",
    contentId: "06_delivery",
  },
];

// コレクションから MDX を取り出して、描画用の Content コンポーネントにする
const requestFlowItems = await Promise.all(
  flowItemData.map(async ({ contentId, ...flowItem }) => {
    const entry = await getEntry("flowItem", contentId);
    if (!entry) {
      throw new Error(`flow-item-md/${contentId}.mdx が見つかりません`);
    }
    const { Content } = await render(entry);
    return { ...flowItem, Content };
  }),
);
---

<div class="flex w-full flex-col gap-5">
  <div
    class="flex flex-wrap items-center justify-center md:justify-end gap-2 pt-1.5 sm:pl-18"
  >
    <p class="m-0 text-xs text-(--ink-soft)">
      各カードをクリックすると詳細が表示されます
    </p>
  </div>
  <ol class="m-0 flex list-none flex-col p-0">
    {
      requestFlowItems.map(({ Content, ...flowItem }, index) => {
        const isLast = index === requestFlowItems.length - 1;
        return (
          <li
            class:list={[
              "group/step relative flex gap-3 sm:gap-6",
              !isLast && "pb-3.5",
            ]}
          >
            {/* マーカー同士をつなぐ線。次のマーカーの 6px 手前まで伸ばす */}
            {!isLast && (
              <span
                aria-hidden="true"
                class="absolute top-19 -bottom-4 left-[23.5px] w-px bg-(--rule)"
              />
            )}
            <div class="flex w-12 shrink-0 flex-col items-center pt-5">
              <span
                aria-hidden="true"
                class="flex size-12 items-center justify-center rounded-full border border-(--rule) bg-(--paper) text-lg text-(--ink-soft) transition-colors duration-300 group-has-[details[open]]/step:border-(--accent) group-has-[details[open]]/step:bg-(--flow-badge-open) group-has-[details[open]]/step:text-(--flow-badge-open-fg)"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>

            <details class="flow-step group min-w-0 flex-1 rounded-[14px] border border-(--rule) bg-(--flow-card) transition-colors duration-300 open:border-(--flow-card-open-border) open:bg-(--flow-card-open)">
              <summary class="flex h-[92px] cursor-pointer list-none items-center gap-4 px-5 sm:gap-6 sm:px-8 [&::-webkit-details-marker]:hidden">
                <span class="min-w-0 flex-1 text-lg font-medium text-(--ink) sm:text-xl">
                  {flowItem.name}
                </span>
                <span class="hidden text-[10px] tracking-[0.08em] text-(--ink-soft) uppercase transition-colors duration-300 group-open:text-(--accent) sm:inline">
                  {flowItem.nameEn}
                </span>
                <span
                  aria-hidden="true"
                  class="flex size-9 shrink-0 items-center justify-center rounded-full border border-(--rule) text-(--ink) transition-colors duration-300 group-open:border-(--flow-card-open-border) group-open:bg-(--flow-badge-open) group-open:text-(--flow-badge-open-fg)"
                >
                  <Plus size={14} class="group-open:hidden" />
                  <Minus size={14} class="hidden group-open:block" />
                </span>
              </summary>
              {/* 本文の見た目は styles.css の .prose-compact */}
              <div class="prose-compact px-5 pb-7 sm:px-8">
                <Content components={{ a: ExternalLink }} />
              </div>
            </details>
          </li>
        );
      })
    }
  </ol>
</div>
