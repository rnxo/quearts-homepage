---
import type { Service } from '#/models/contact/service.model'

type Props = {
  services: Service[]
}

const { services } = Astro.props
---

<dl class="m-0">
  {services.map((service) => (
    <div class="grid grid-cols-1 gap-2 border-b border-(--rule)/60 py-4 first:pt-0 last:border-b-0 last:pb-0 sm:grid-cols-[220px_1fr] sm:items-center sm:gap-6">
      <dt>
        <span class="block text-sm font-bold">{service.name}</span>
        <span class="kicker mt-1 block text-[0.625rem]">{service.nameEn}</span>
      </dt>
      <dd class="flex justify-end mx-4 text-sm leading-7 text-(--ink-soft)">
        {service.description}
      </dd>
    </div>
  ))}
</dl>
