---
import type { PriceRow } from "#/models/contact/price.model";
import PriceTableMd from "./PriceTable-md.astro";
import PriceTableSm from "./PriceTable-sm.astro";

type Props = {
  prices: PriceRow[];
};

const { prices } = Astro.props;
---

<div>
  {/* 768px 未満用。表は列が収まらないので、1行ずつ縦に積む */}
  <PriceTableSm prices={prices} />
  <PriceTableMd prices={prices} />
  {/* <p class="mt-6 mb-0 text-sm leading-7 text-(--ink-soft)">{note}</p> */}
  <p class="mt-6 mb-0 text-sm leading-7 text-(--ink-soft)">
    お支払いは基本Paypalもしくは銀行振込になります
  </p>
</div>
