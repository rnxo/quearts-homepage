---
import { formatDate } from '#/lib/format'
import { sortedNews } from '#/models/news'

const NEW_DAYS = 7
const now = Date.now()
const isNew = (iso: string) =>
  (now - new Date(iso).getTime()) / 86_400_000 <= NEW_DAYS
---

<ul class="m-0 mx-auto max-w-[880px] list-none border-b border-(--rule) p-0">
  {sortedNews.map((item) => {
    // リンクがある記事だけ、行全体を押せるようにする
    const href = item.links?.youtube
    const Row = href ? 'a' : 'div'
    return (
      <li class="border-b border-(--rule)">
        <Row
          href={href}
          target={href ? '_blank' : undefined}
          rel={href ? 'noreferrer' : undefined}
          class:list={[
            'group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-6 px-2 py-6.5 text-(--ink) no-underline',
            href &&
              'transition-colors hover:bg-(--paper-sub) focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--ink) motion-reduce:transition-none',
          ]}
        >
          <span class="min-w-0">
            {/* 1段目: NEW、日付、カテゴリ */}
            <span class="flex items-baseline gap-3 text-[13px] tracking-[0.06em] text-(--ink-soft) tabular-nums">
              {isNew(item.releasedAt) && (
                <span class="text-[11px] font-semibold tracking-[0.16em] text-(--accent)">
                  NEW
                </span>
              )}
              <time datetime={item.releasedAt}>
                {formatDate(item.releasedAt)}
              </time>
              <span class="text-[11px] tracking-[0.16em] uppercase">
                {item.category}
              </span>
            </span>
            {/* 2段目: タイトル */}
            <span class="mt-1.5 block text-[17px] leading-relaxed font-medium text-pretty decoration-1 underline-offset-[6px] group-hover:underline sm:text-xl">
              {item.title}
            </span>
          </span>
          {href && (
            <span
              aria-hidden="true"
              class="text-base text-(--ink-soft) transition-transform group-hover:translate-x-1 group-hover:text-(--ink) motion-reduce:transition-none"
            >
              →
            </span>
          )}
        </Row>
      </li>
    )
  })}
</ul>
