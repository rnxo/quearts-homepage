---
import { formatDate } from '#/lib/format'
import { news } from '#/models/news'
import SongLinks from '../SongLinks';
---

<ul class="m-0 list-none p-0">
  {news.map((item) => (
    <li class="flex gap-4 sm:gap-6">
      {/* 左の列: 丸印と縦線。li の高さいっぱいに伸びる */}
      {/* pt-7 = 右の列の py-6 (24px) + 日付行 20px の中心 - 丸印の半径 6px */}
      <div
        aria-hidden="true"
        class="flex shrink-0 flex-col items-center gap-2 pt-7"
      >
        <span class="size-3 shrink-0 rounded-full border border-(--ink)"></span>
        <span class="w-px flex-1 bg-(--rule)"></span>
      </div>
      {/* 右の列: 記事の中身 */}
      <div class="flex min-w-0 flex-1 flex-col items-start py-6">
        {/* 日付とタイプタグ: 縦の中央で揃える */}
        <div class="flex flex-wrap items-center gap-3">
          <span class="kicker">{formatDate(item.releasedAt)}</span>
          {/* タイプタグ: 文字の幅だけの小さな丸いラベル */}
          <span class="inline-flex items-center rounded-full border border-(--rule) bg-(--paper-sub) px-2.5 py-1 text-[10px] leading-none font-semibold tracking-[0.16em] text-(--ink-soft) uppercase">
            { item.category }
          </span>
        </div>
        <h3 class="mt-3 text-xl leading-snug font-bold sm:text-2xl">
          {item.title}
        </h3>
        <SongLinks 
          youtube={item.links?.youtube}
          niconico={item.links?.niconico}
          piapro={item.links?.piapro}
        />
      </div>
    </li>
  ))}
</ul>
