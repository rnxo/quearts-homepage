---
import { formatDate } from '#/lib/format'
import { news } from '#/models/news'
---

<ul class="m-0 list-none p-0">
  {news.map((item) => (
    <li class="flex gap-4 sm:gap-6">
      {/* 左の列: 丸印と縦線。li の高さいっぱいに伸びる */}
      {/* pt-7 = 右の列の py-6 (24px) + 日付行 20px の中心 - 丸印の半径 6px */}
      <div
        aria-hidden="true"
        class="flex shrink-0 flex-col items-center gap-2 pt-7"
      >
        <span class="size-3 shrink-0 rounded-full border border-(--ink)"></span>
        <span class="w-px flex-1 bg-(--rule)"></span>
      </div>
      {/* 右の列: 記事の中身 */}
      <div class="flex min-w-0 flex-1 flex-col items-start py-6">
        {/* 日付とタイプタグ: 縦の中央で揃える */}
        <div class="flex flex-wrap items-center gap-3">
          <span class="kicker">{formatDate(item.releasedAt)}</span>
          {/* タイプタグ: 文字の幅だけの小さな丸いラベル */}
          <span class="inline-flex items-center rounded-full border border-(--rule) bg-(--paper-sub) px-2.5 py-1 text-[10px] leading-none font-semibold tracking-[0.16em] text-(--ink-soft)">
            MUSIC
          </span>
        </div>
        <h3 class="mt-3 text-xl leading-snug font-bold sm:text-2xl">
          {item.title}
        </h3>
        {item.body && (
          <p class="mt-2 max-w-2xl text-sm leading-7 text-(--ink-soft)">
            {item.body}
          </p>
        )}
        <a
          href="https://www.youtube.com"
          target="_blank"
          rel="noreferrer"
          class="mt-4 text-sm font-medium text-(--ink) underline-offset-4 hover:underline"
        >
          動画を見る →
        </a>
      </div>
    </li>
  ))}
</ul>
