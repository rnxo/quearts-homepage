---

<div class={`flex justify-between items-center gap-3 p-4 ${className}`}>
  <label class="text-sm text-(--ink-soft)">各種リンク</label>
  <div class="flex justify-between items-center gap-3">
    {youtube && (
      <a
        href={youtube}
        target="_blank"
        rel="noreferrer"
        aria-label="YouTube"
        title="YouTube"
        class={linkClass}
      >
        <span class="text-sm text-(--ink-soft) hover:underline">YouTube</span>
      </a>
    )}
    {niconico && (
      <a
        href={niconico}
        target="_blank"
        rel="noreferrer"
        aria-label="niconico"
        title="niconico"
        class={linkClass}
      >
        <span class="text-sm text-(--ink-soft) hover:underline">ニコニコ</span>
      </a>
    )}
    {piapro && (
      <a
        href={piapro}
        target="_blank"
        rel="noreferrer"
        aria-label="piapro"
        title="piapro(inst)"
        class={linkClass}
      >
        <span class="text-sm text-(--ink-soft) hover:underline">piapro</span>
      </a>
    )}
  </div>
</div>
