---
type Props = {
  youtube?: string;
  niconico?: string;
  piapro?: string;
  class?: string;
};

const {
  youtube = "",
  niconico = "",
  piapro = "",
  class: className = "",
} = Astro.props;

// 表示するリンクの定義。URL が空のものは出さない
const links = [
  { href: youtube, name: "YouTube", note: "MVを見る" },
  { href: niconico, name: "ニコニコ", note: "MVを見る" },
  { href: piapro, name: "piapro", note: "インスト・素材" },
].filter((link) => link.href);
---

{
  links.length > 0 && (
    <div class:list={["flex flex-col gap-3 p-4", className]}>
      <p class="m-0 text-xs tracking-[0.08em] text-(--ink-soft) text-center">
        各種リンク
      </p>
      <ul class="m-0 grid list-none grid-cols-1 lg:grid-cols-[repeat(auto-fit,minmax(6rem,1fr))] gap-2 p-0">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="group flex h-full flex-col items-center justify-center gap-0.5 rounded-md px-3 py-2.5 text-center no-underline ring-1 ring-(--rule) transition-colors hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--ink) motion-reduce:transition-none"
            >
              <span class="text-sm font-medium text-(--ink) transition-colors group-hover:text-neutral-900 motion-reduce:transition-none">
                {link.name}
              </span>
              <span class="text-xs text-(--ink-soft) transition-colors group-hover:text-neutral-600 motion-reduce:transition-none">
                {link.note}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
